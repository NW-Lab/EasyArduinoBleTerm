<Window
    x:Class="EasyArduinoBleTerm.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="EasyArduinoBleTerm">

    <Grid RowDefinitions="Auto,*">

        <!-- Title bar area -->
        <Grid Grid.Row="0"
              Background="{ThemeResource NavigationViewTopPaneBackground}"
              Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- App title -->
            <TextBlock Grid.Column="0"
                       Text="EasyArduinoBleTerm"
                       FontWeight="SemiBold"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

            <!-- Tab selector -->
            <TabView Grid.Column="1"
                     x:Name="MainTabView"
                     IsAddTabButtonVisible="False"
                     TabWidthMode="Equal"
                     SelectionChanged="MainTabView_SelectionChanged"
                     VerticalAlignment="Center">
                <TabViewItem Header="ターミナル" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE756;"/>
                    </TabViewItem.IconSource>
                </TabViewItem>
                <TabViewItem Header="プロッター" IsClosable="False">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE9D2;"/>
                    </TabViewItem.IconSource>
                </TabViewItem>
            </TabView>

            <!-- Connection status -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <Ellipse x:Name="StatusDot"
                         Width="10" Height="10"
                         Fill="Gray"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText"
                           Text="未接続"
                           VerticalAlignment="Center"
                           FontSize="13"
                           MinWidth="120"/>
            </StackPanel>

            <!-- Connect / Disconnect button -->
            <Button Grid.Column="3"
                    x:Name="ConnectButton"
                    Content="接続"
                    Click="ConnectButton_Click"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- Content area -->
        <Frame Grid.Row="1" x:Name="ContentFrame"/>

    </Grid>
</Window>
