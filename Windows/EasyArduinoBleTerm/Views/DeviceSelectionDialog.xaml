<ContentDialog
    x:Class="EasyArduinoBleTerm.Views.DeviceSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:EasyArduinoBleTerm.Services"
    Title="BLE デバイスを選択"
    PrimaryButtonText="接続"
    CloseButtonText="キャンセル"
    DefaultButton="Primary">

    <Grid Width="400" RowDefinitions="Auto,Auto,*" RowSpacing="8">

        <!-- Scan controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ScanButton"
                    Content="スキャン開始"
                    Click="ScanButton_Click"
                    Style="{ThemeResource AccentButtonStyle}"/>
            <ProgressRing x:Name="ScanProgress"
                          IsActive="False"
                          Width="24" Height="24"
                          VerticalAlignment="Center"/>
            <TextBlock x:Name="ScanStatusText"
                       Text="スキャンを開始してください"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Column headers -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Padding="12,4">
            <TextBlock Grid.Column="0" Text="デバイス名" FontWeight="SemiBold" FontSize="12"/>
            <TextBlock Grid.Column="1" Text="RSSI" FontWeight="SemiBold" FontSize="12" Margin="16,0"/>
            <TextBlock Grid.Column="2" Text="アドレス" FontWeight="SemiBold" FontSize="12"/>
        </Grid>

        <!-- Device list -->
        <ListView x:Name="DeviceListView"
                  Grid.Row="2"
                  MinHeight="200"
                  MaxHeight="320"
                  ItemsSource="{x:Bind ViewModel.DiscoveredDevices}"
                  SelectionChanged="DeviceListView_SelectionChanged"
                  SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="services:BleDeviceInfo">
                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,4">
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind Name}"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind RssiText}"
                                   VerticalAlignment="Center"
                                   Margin="16,0"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{x:Bind Address}"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</ContentDialog>
