<Page
    x:Class="EasyArduinoBleTerm.Views.TerminalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8"
                    Padding="8,6" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

            <ToggleButton x:Name="TimestampToggle"
                          IsChecked="{x:Bind ViewModel.ShowTimestamp, Mode=TwoWay}"
                          Content="日時表示"
                          ToolTipService.ToolTip="受信日時の表示をON/OFFします"/>

            <ToggleButton x:Name="AutoScrollToggle"
                          IsChecked="{x:Bind ViewModel.AutoScroll, Mode=TwoWay}"
                          Content="自動スクロール"
                          ToolTipService.ToolTip="新しいデータが来たとき自動的に末尾にスクロールします"/>

            <Button Command="{x:Bind ViewModel.ClearCommand}"
                    Content="クリア"
                    ToolTipService.ToolTip="ターミナルをクリアします"/>
        </StackPanel>

        <!-- Terminal output -->
        <ScrollViewer x:Name="TerminalScroller"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="#1A1A1A">
            <ItemsControl x:Name="LinesList"
                          ItemsSource="{x:Bind ViewModel.Lines}"
                          Padding="8,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#00FF88"
                                   TextWrapping="NoWrap"
                                   Margin="0,1"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Send area -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto"
              Padding="8,6" Spacing="8"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBox Grid.Column="0"
                     x:Name="SendTextBox"
                     PlaceholderText="送信するテキストを入力..."
                     Text="{x:Bind ViewModel.SendText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="Consolas"
                     KeyDown="SendTextBox_KeyDown"/>
            <Button Grid.Column="1"
                    Command="{x:Bind ViewModel.SendCommand}"
                    Content="送信"
                    Style="{ThemeResource AccentButtonStyle}"/>
        </Grid>

    </Grid>
</Page>
